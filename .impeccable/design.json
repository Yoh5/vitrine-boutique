  },
  {
   "name": "Champ de recherche",
   "kind": "input",
   "refersTo": "input",
   "description": "Recherche sur l'étagère, sur fond d'émail.",
   "html": "<div class=\"ds-fond\"><input class=\"ds-input\" placeholder=\"Chercher sur les étagères\"></div>",
   "css": ":host{--etagere:#0f5c6e;--etagere-fonce:#0a4250;--kraft:#cda36b;--kraft-clair:#e3c99a;--encre:#17150f;--rouge:#c8102e;--rouge-fonce:#9c0c23;--mur-clair:#f6f8f7;--bois:#7a4e2d;--bois-fonce:#573620}.ds-fond{background:var(--etagere);padding:1rem}.ds-input{width:100%;min-height:44px;border:0;border-radius:6px;padding:0 1rem;background:var(--mur-clair);color:var(--encre);font:400 1rem Archivo,system-ui,sans-serif;caret-color:var(--rouge)}.ds-input:focus-visible{outline:3px solid var(--kraft-clair);outline-offset:2px}"
  },
  {
   "name": "Étiquette de prix",
   "kind": "custom",
   "refersTo": "etiquette",
   "description": "Le carton accroché sous la planche : nom et prix au feutre, code de case.",
   "html": "<div class=\"ds-fond\"><div class=\"ds-planche\"></div><div class=\"ds-etiquette\"><span class=\"ds-code\">A-01</span><div class=\"ds-nom\">Huile d'argan 100&nbsp;ml</div><div class=\"ds-prix\">120 DH</div><div class=\"ds-stock\">Plus que 2</div></div></div>",
   "css": ":host{--etagere:#0f5c6e;--etagere-fonce:#0a4250;--kraft:#cda36b;--kraft-clair:#e3c99a;--encre:#17150f;--rouge:#c8102e;--rouge-fonce:#9c0c23;--mur-clair:#f6f8f7;--bois:#7a4e2d;--bois-fonce:#573620}.ds-fond{background:var(--etagere);padding:1rem 1rem 1.5rem;max-width:16rem}.ds-planche{height:14px;background:var(--bois);box-shadow:0 6px 8px -4px rgb(0 0 0/.45)}.ds-etiquette{position:relative;margin:-2px auto 0;width:calc(100% - 1.6rem);background:var(--kraft);color:var(--encre);padding:.85rem .7rem .6rem;border-radius:2px 2px 4px 4px;box-shadow:0 3px 6px rgb(0 0 0/.3);rotate:-1.6deg;transition:rotate .4s cubic-bezier(.16,1,.3,1)}.ds-etiquette:hover{rotate:0deg}.ds-etiquette::before{content:'';position:absolute;top:.3rem;left:50%;translate:-50% 0;width:7px;height:7px;border-radius:50%;background:var(--etagere)}.ds-code{position:absolute;top:.45rem;right:.55rem;font:700 .72rem Archivo,sans-serif;letter-spacing:.04em}.ds-nom{font:700 1.05rem/1.2 Kalam,cursive;padding-right:2.4rem}.ds-prix{font:700 1.6rem/1.1 Kalam,cursive}.ds-stock{font:700 .85rem Archivo,sans-serif;color:#9c0c23}"
  },
