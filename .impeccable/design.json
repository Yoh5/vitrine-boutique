   "description": "L'unique action rouge de la vue (Au comptoir, Commander).",
   "html": "<button class=\"ds-btn-action\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>Commander</button>",
   "css": ":host{--etagere:#0f5c6e;--etagere-fonce:#0a4250;--kraft:#cda36b;--kraft-clair:#e3c99a;--encre:#17150f;--rouge:#c8102e;--rouge-fonce:#9c0c23;--mur-clair:#f6f8f7;--bois:#7a4e2d;--bois-fonce:#573620}.ds-btn-action{display:inline-flex;align-items:center;gap:.5rem;min-height:48px;padding:0 1.2rem;border-radius:6px;border:2px solid var(--rouge);background:var(--rouge);color:#fff;font:700 1rem Archivo,system-ui,sans-serif;cursor:pointer;transition:background .2s,translate .2s}.ds-btn-action:hover{background:var(--rouge-fonce);border-color:var(--rouge-fonce)}.ds-btn-action:active{translate:0 1px}.ds-btn-action:focus-visible{outline:3px solid var(--rouge);outline-offset:2px}"
