---
// Icônes Lucide (licence ISC) : voir src/lib/icones.ts.
import { ICONES } from '../lib/icones';
interface Props { nom: keyof typeof P; taille?: number; class?: string }
const P = ICONES;
const { nom, taille = 20, class: cls } = Astro.props;
---
<svg class={cls} width={taille} height={taille} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={P[nom]} />
